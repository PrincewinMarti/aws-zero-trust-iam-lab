# Copy to config.env and fill in with values from your own environment.
# config.env is gitignored — it holds real identifiers.
#
#   aws sso-admin list-instances \
#     --query 'Instances[0].[InstanceArn,IdentityStoreId]' --output text
#   aws organizations list-accounts \
#     --query 'Accounts[*].[Name,Id]' --output table

INSTANCE_ARN="arn:aws:sso:::instance/ssoins-XXXXXXXXXXXXXXXX"
IDENTITY_STORE_ID="d-XXXXXXXXXX"

ACC_MGMT="111111111111"
ACC_DEV="222222222222"
ACC_PROD="333333333333"

# Base address for simulated users. Plus-addressing keeps each unique
# while delivering to one inbox: you+dev1@gmail.com
EMAIL_BASE="you"

# Populated by 01-create-permission-sets.sh
PS_ADMIN=""
PS_DEV=""
PS_AUDIT=""

# Populated by 02-create-users-and-groups.sh
G_ADMIN=""
G_DEV=""
G_AUD=""
