{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyObjectsOutsideOwnDepartment",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectTagging",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::zt-lab-abac-*/*",
      "Condition": {
        "StringNotEquals": {
          "s3:ExistingObjectTag/Department": "${aws:PrincipalTag/Department}"
        }
      }
    }
  ]
}
